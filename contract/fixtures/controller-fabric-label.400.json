{
  "route": "PUT /controller/fabric/label",
  "request": {
    "method": "PUT",
    "path": "/controller/fabric/label",
    "headers": {
      "X-Fabric-UI-Token": "test-token"
    },
    "body": {
      "label": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    }
  },
  "response": {
    "status": 400,
    "body": {
      "code": "bad_request",
      "detail": "label: longer than 32 characters",
      "instance": "/api/v1/controller/fabric/label",
      "status": 400,
      "title": "Invalid request",
      "type": "https://github.com/SukramJ/go-fabric-ui/blob/main/docs/contract.md#problem-bad_request"
    }
  }
}
